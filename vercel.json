{
  "buildCommand": "npm run install:all && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/products-remote/(.*)", "destination": "/products-remote/$1" },
    { "source": "/cart-remote/(.*)", "destination": "/cart-remote/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
